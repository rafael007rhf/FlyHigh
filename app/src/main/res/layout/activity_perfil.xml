<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/flyhigh_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/historico_titulo" android:textColor="@color/flyhigh_yellow" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtResumo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_metric_card" android:gravity="center" android:padding="10dp" android:textColor="@color/flyhigh_white" android:textSize="10sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/listaCorridas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
        <Button android:id="@+id/btnVoltar" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginTop="10dp" android:background="@drawable/bg_metric_card" android:text="@string/btn_voltar" android:textColor="@color/flyhigh_yellow" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
